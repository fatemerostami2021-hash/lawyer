# ===== Portal API settings (this file is private: never upload it to GitHub) =====
PORT=4000
JWT_SECRET=put-a-long-random-text-here

# Lawyer / assistant panel logins (change before showing a real client!)
LAWYER_USERNAME=lawyer
LAWYER_PASSWORD=Demo@1234
ASSISTANT_USERNAME=assistant
ASSISTANT_PASSWORD=Demo@1234

# Telegram bot: @Fitmindsetbot  (after the demo: BotFather -> /revoke -> paste the new token here)
TELEGRAM_BOT_TOKEN=
# Leave empty: the first account that sends /start to the bot becomes the owner.
TELEGRAM_OWNER_CHAT_ID=

# Demo: show the one-time login code on the screen (set false when SMS is connected)
DEMO_SHOW_OTP=true
# Optional real SMS (sms.ir): fill both to send the code by SMS
SMSIR_API_KEY=
SMSIR_TEMPLATE_ID=

# Allowed website addresses (local dev). Add your Vercel domain when deploying.
CLIENT_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
